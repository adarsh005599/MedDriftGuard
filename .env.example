# MedDriftGuard Environment Variables
# Copy this file to .env and configure as needed.

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# API Server
API_HOST=127.0.0.1
API_PORT=8000

# Local Model & Service Endpoints (Free / Open-Source)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:3b
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-large

# Local Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=kb/index/qdrant_local

# Knowledge Base & Storage
KB_CHUNKS_PATH=kb/chunks.jsonl
RESULTS_DIR=results/
DATA_DIR=data/
